#!/usr/bin/env python3
"""Build the local BlueZ pairing agent against public Qt D-Bus/QML APIs."""
from pathlib import Path
import os
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
source = root / 'integrations/BluetoothNative'
destination = Path(os.environ.get('QS_BUILD_ROOT', str(root))) / 'integrations/BluetoothNative'
with tempfile.TemporaryDirectory(prefix='qs-bluetooth-build-') as build:
    subprocess.run(['qmake6', str(source / 'bluetooth.pro')], cwd=build, check=True)
    subprocess.run(['make', '-j2'], cwd=build, check=True)
    destination.mkdir(parents=True, exist_ok=True)
    temporary = destination / '.libbluetoothagent.so.new'
    shutil.copy2(Path(build) / 'libbluetoothagent.so', temporary)
    os.replace(temporary, destination / 'libbluetoothagent.so')
print('Built Bluetooth pairing agent for the installed Qt.')
