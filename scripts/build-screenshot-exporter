#!/usr/bin/env python3
"""Build against the installed Qt using public headers, without system installs."""
from pathlib import Path
import os
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parents[1]
source = root / 'integrations/ScreenshotNative'
destination = Path(os.environ.get('QS_BUILD_ROOT', str(root))) / 'integrations/ScreenshotNative'
with tempfile.TemporaryDirectory(prefix='qs-screenshot-build-') as build:
    subprocess.run(['qmake6', str(source / 'screenshot.pro')], cwd=build, check=True)
    subprocess.run(['make', '-j2'], cwd=build, check=True)
    destination.mkdir(parents=True, exist_ok=True)
    temporary = destination / '.libscreenshotexport.so.new'
    shutil.copy2(Path(build) / 'libscreenshotexport.so', temporary)
    os.replace(temporary, destination / 'libscreenshotexport.so')
print('Built screenshot exporter for the installed Qt.')
