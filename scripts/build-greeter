#!/usr/bin/env python3
"""Build the greetd transport. Test peer support never replaces production output."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument('--test-output', type=Path)
args = parser.parse_args()
root = Path(__file__).resolve().parents[1]
source = root / 'integrations/GreeterNative'
with tempfile.TemporaryDirectory(prefix='qs-greeter-build-') as directory:
    build = Path(directory)
    command = ['qmake6', str(source / 'greeter.pro')]
    if args.test_output:
        command.append('CONFIG+=greeter_test')
    subprocess.run(command, cwd=build, check=True)
    subprocess.run(['make', '-j2'], cwd=build, check=True)
    destination = args.test_output if args.test_output else source
    if args.test_output:
        assert destination.resolve() != source.resolve()
    destination.mkdir(parents=True, exist_ok=True)
    temporary = destination / 'libgreetdclient.so.new'
    shutil.copy2(build / 'libgreetdclient.so', temporary)
    os.replace(temporary, destination / 'libgreetdclient.so')
    if args.test_output:
        shutil.copy2(source / 'qmldir', destination / 'qmldir')
    # The gate has no test variant and never reads credentials or authenticates.
    gate = build / 'pam_greeter_gate.so'
    subprocess.run(['cc', '-O2', '-Wall', '-Wextra', '-Werror', '-shared', '-fPIC',
        '-Wl,-z,relro,-z,now', '-o', str(gate), str(source / 'pam-greeter-gate.c'), '-lpam'], check=True)
    shutil.copy2(gate, destination / 'pam_greeter_gate.so')
print('Built', 'test-only' if args.test_output else 'production', 'greetd transport:', destination)
