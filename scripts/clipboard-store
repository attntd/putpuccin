#!/bin/sh
set -eu

case "${CLIPBOARD_STATE:-data}" in
    sensitive|nil|clear)
        exit 0
        ;;
esac

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
max_bytes="${QS_CLIP_MAX_BYTES:-2097152}"
temp_file="$(mktemp "${runtime_dir}/quickshell-de-clip.XXXXXX")"
trap 'rm -f -- "$temp_file"' EXIT HUP INT TERM

head -c "$((max_bytes + 1))" > "$temp_file"
byte_count="$(wc -c < "$temp_file")"
[ "$byte_count" -le "$max_bytes" ] || exit 0
[ "$byte_count" -gt 0 ] || exit 0

cliphist store < "$temp_file"
printf '%s\n' stored
