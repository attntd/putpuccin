#!/usr/bin/env python3
"""Build all native runtime modules, without modifying tracked source files."""
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
for script in (
    "build-screenshot-exporter",
    "build-bluetooth-agent",
    "build-session-inhibitor",
    "build-network-editor",
    "build-lock-observer",
):
    subprocess.run([sys.executable, str(root / "scripts" / script)], check=True)
